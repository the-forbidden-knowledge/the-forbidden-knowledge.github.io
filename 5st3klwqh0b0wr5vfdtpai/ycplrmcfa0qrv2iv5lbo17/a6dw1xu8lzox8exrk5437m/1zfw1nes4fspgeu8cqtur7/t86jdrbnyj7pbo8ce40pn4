<script>
(function () {
  var LAYOUT = "../../is96rxiu0g4q16ku7gsy80/2y2q2a0z31yrqenhnkceck/7055wjnggsmbtc2wretzlc";
  var HOME = "hl0nl7baieaoiwq3y37n8v";
  if (window.topbar) topbar.config({barColors: {0: "#29d"}, shadowColor: "rgba(0, 0, 0, .3)"});
  function pageLoadingStart() { if (window.topbar) topbar.show(); }
  function pageLoadingStop() { if (window.topbar) topbar.hide(); }
  function get(url) {
    return fetch(url, {cache: "no-store"}).then(function (r) {
      if (!r.ok) throw new Error("HTTP " + r.status + " em " + url);
      return r.text();
    });
  }
  function bodyOf(html) {
    return new DOMParser().parseFromString(html, "text/html").body.innerHTML;
  }
  function wireTheme() {
    var saved = null;
    try { saved = localStorage.getItem("theme") || "light"; } catch (e) { saved = "light"; }
    document.documentElement.setAttribute("data-theme", saved);
    var btn = document.getElementById("theme-toggle");
    if (btn) btn.addEventListener("click", function () {
      var h = document.documentElement;
      var t = h.getAttribute("data-theme") === "dark" ? "light" : "dark";
      h.setAttribute("data-theme", t);
      try { localStorage.setItem("theme", t); } catch (e) {}
    });
  }
  // Navegacao do SPA: troca a pagina sem recarregar (ex.: navigate("sobre-content.html"))
  window.navigate = function (page) {
    pageLoadingStart();
    get(page).then(function (html) {
      document.getElementById("inner-content").innerHTML = bodyOf(html);
      wireTheme();
      pageLoadingStop();
    }).catch(function (err) {
      pageLoadingStop();
      document.getElementById("inner-content").innerHTML =
        "<p style='padding:2rem;font-family:sans-serif'>Erro ao carregar a pagina (" + err.message + ").</p>";
    });
  };
  // Boot: layout + conteudo inicial
  pageLoadingStart();
  get(LAYOUT)
    .then(function (html) {
      document.getElementById("app").innerHTML = bodyOf(html);
      return get(HOME);
    })
    .then(function (html) {
      document.getElementById("inner-content").innerHTML = bodyOf(html);
      wireTheme();
      pageLoadingStop();
    })
    .catch(function (err) {
      pageLoadingStop();
      document.getElementById("app").innerHTML =
        "<p style='padding:2rem;font-family:sans-serif'>The Forbbiden Knowledge — erro ao carregar (" + err.message + ").</p>";
    });
})();
</script>
